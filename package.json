{
    "name": "kids-quiz",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "desktop": "npm run build && electron .",
        "desktop:pack": "npm run build && electron-builder --dir",
        "dist:win": "npm run build && electron-builder --win nsis portable",
        "license:generate": "node scripts/generate-license.mjs",
        "test:fuzzy": "node scripts/test-fuzzy.mjs",
        "test:questions": "node scripts/test-questions.mjs",
        "lint": "eslint .",
        "test:ui": "vitest run",
        "test": "npm run test:fuzzy && npm run test:questions && npm run test:ui"
    },
    "dependencies": {
        "@fontsource/assistant": "^5.2.9",
        "@fontsource/frank-ruhl-libre": "^5.3.0",
        "lucide-react": "^1.11.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.20",
        "electron": "^44.11.6",
        "electron-builder": "^26.18.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^17.14.0",
        "jsdom": "^25.0.1",
        "postcss": "^8.5.33",
        "tailwindcss": "^3.4.11",
        "vite": "^6.4.6",
        "vitest": "^4.1.12"
    },
    "build": {
        "appId": "com.kidsquiz.offline",
        "productName": "KidsQuiz Offline",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asar": true,
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "signAndEditExecutable": false,
            "verifyUpdateCodeSignature": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "KidsQuiz Offline"
        }
    }
}
